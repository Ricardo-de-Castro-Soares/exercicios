programa
{
	
	funcao inicio()
	{
	// Algoritimo onde o computador soteia um numero e o usuario tenta descobrir
	
	inteiro numero

	escreva("Digite um número: ")
	leia(numero)

	se(numero >=1 e numero <=5){
		escreva("Parabéns você encontrou o numero da sorte que é ",numero)
	}senao{
		escreva("Infelizmente você errou o numero da sorte, tente novamente")
	}
	}
}
