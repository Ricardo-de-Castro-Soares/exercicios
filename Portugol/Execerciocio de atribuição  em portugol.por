programa
{
	
	funcao inicio()
	{ 
	cadeia nome
	real s

	escreva("Digite seu nome: ")
	leia(nome)

	escreva("Digite seu salário: ")
	leia (s)

	escreva("O " , nome , " ganha " , s , " de salario por més")
	}
}
