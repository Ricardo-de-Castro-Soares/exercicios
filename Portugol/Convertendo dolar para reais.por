programa
{
	
	funcao inicio()
	{
	real dolar, reais, cotacao

	escreva("qual a cotação atual do dólar: ")
	leia(cotacao)
	escreva("Valor que deseja converter para Reais: ")
	leia(dolar)


	reais = (cotacao * dolar)
	escreva("O valor em  reais foi R$", reais)
	}
}
