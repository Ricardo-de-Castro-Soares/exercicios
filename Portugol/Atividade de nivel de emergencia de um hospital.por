programa
{
	
	funcao inicio()
	{
	inteiro numero

	escreva("Digite o numero do codigo: ")
	leia(numero)
		

	escolha(numero){
		caso  1:
		escreva("Cor: Verde", "\n" ,"Prioridade de Atendimento: Pouco urgente")
		pare
		caso  2:
		escreva("Cor: Amarelo", "\n" ,"Prioridade de Atendimento: Urgente")
		pare
		caso  3:
		escreva("Cor: Laranja", "\n" ,"Prioridade de Atendimento: Muito Urgente")
		pare
		caso  4:
		escreva("Cor: Vermelho", "\n" ,"Prioridade de Atendimento: Emergência")
		pare
     
	caso contrario:
	escreva("Código inválido.")
	}
	}
}
