programa
{
	
	funcao inicio()
	{
	inteiro ano

	escreva("Digite qualquer ano: ")
	leia(ano)

	se(ano % 4 == 0){
		escreva("O ano de ", ano , " é um ano bisexto")
	}
	senao{
		escreva("O ano de ", ano , " não é um ano bisexto")
	}
	}
}
