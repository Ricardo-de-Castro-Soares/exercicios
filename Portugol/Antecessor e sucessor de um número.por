programa
{
	
	funcao inicio()
	{
	inteiro n1 , s , su

	escreva("Digite um número: ")
	leia(n1)

	s = (n1 - 1)
	escreva("O antecessor de ", n1 , " é " ,s , "\n")
	
	su = (n1 + 1)
	escreva("O sucessor de ", n1 , " é ",su)
	}
}
