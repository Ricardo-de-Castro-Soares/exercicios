programa
{
	
	funcao inicio()
	{
	inteiro num1, num2, troca

	escreva("Digite um numero: ")
	leia(num1)
	escreva("digite outro numero: ")
	leia(num2)

	troca = num1
	num1 = num2
	num2 = troca
	escreva("Essses são os número invertido ", num1 , " e ", num2)
	}
}
