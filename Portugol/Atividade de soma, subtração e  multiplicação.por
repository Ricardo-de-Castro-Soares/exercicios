programa
{
	
	funcao inicio()
	{//recebe dois numero, soma, subtrai e multiplica depois montrar resultado

	real num1, num2, soma, sub, mult

	escreva("Digite um numero: ")	
	leia(num1)
	escreva("digite outro numero: ")
	leia(num2)

	soma = (num1 + num2)
	escreva("A soma dos dois números é igual a ", soma , "\n")

	sub = (num1 - num2)
	escreva("A subtração dos dois numeros é igual a ", sub , "\n")

	mult = (num1 * num2)
	escreva("A multiplicação dos dois numeros ã igual a ", mult)
	}
}
