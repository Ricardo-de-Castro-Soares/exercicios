programa
{
	
	funcao inicio()
	{
	real n1, d, t

	escreva("Digite um número: ")
	leia(n1)

	d = (n1 * 2)
	escreva("O dobro do número " , n1 , " é " , d , "\n")

	t = (n1 / 3)
	escreva("A terça parte do número " , n1 , " é " , t)
	}
}
